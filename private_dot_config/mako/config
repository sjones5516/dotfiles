# Lamplit Monastery palette
font=JetBrainsMono Nerd Font 11

background-color=#282828ee
text-color=#cbc49c
border-color=#45403d
progress-color=over #383534

width=360
height=140
margin=12
padding=12
border-size=2
border-radius=0
icons=1
max-icon-size=48
default-timeout=6000
anchor=top-right

format=<b>%s</b>\n%b

[urgency=low]
border-color=#3d3a37
text-color=#757f76
default-timeout=4000

[urgency=normal]
border-color=#9fa589

[urgency=high]
border-color=#b07a6e
text-color=#dad0a5
default-timeout=0

[mode=do-not-disturb]
invisible=1
